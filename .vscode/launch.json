{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "cs-app (Qt GUI)",
            "type": "debugpy",
            "request": "launch",
            "module": "cs_app",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "args": [],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python",
                "PYTHONUNBUFFERED": "1"
            },
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true
        }
    ]
}
