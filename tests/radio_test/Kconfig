mainmenu "Radio test driver application"

# Consumed unconditionally by the NCS radio_test.c, so it must be declared even
# though this application does not build the sample's shell front-end.
config RADIO_TEST_RX_TIMEOUT
	int "RX packet reception timeout"
	default 10
	help
	  Time in seconds the driver waits for the first packet in RX mode when a
	  finite packet count is requested. The radio is disabled if it elapses.

source "Kconfig.zephyr"
